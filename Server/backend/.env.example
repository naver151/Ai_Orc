# ──────────────────────────────────────────────────────────────
# AI.Orc 백엔드 환경변수 예시
# 복사 후 .env로 저장하고 실제 값을 채워주세요
# ──────────────────────────────────────────────────────────────

# ── 데이터베이스 ──────────────────────────────────────────────
# PostgreSQL 연결 문자열 (필수)
DATABASE_URL=postgresql://postgres:password@localhost:5432/aiorc

# ── AI 프로바이더 API 키 ──────────────────────────────────────
# GitHub Models (무료, 필수 — 없으면 AI 작동 불가)
# 발급: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 사용할 GitHub 기본 모델 (선택, 기본값: gpt-4.1)
# GITHUB_MODEL=gpt-4.1

# OpenAI (선택 — 유료, 더 강력한 모델 사용 시)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic Claude (선택 — 유료, 교차 검증에 활용)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 사용할 Claude 모델 (선택, 기본값: claude-3-5-sonnet-20241022)
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (선택 — 유료)
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 웹 검색 ──────────────────────────────────────────────────
# Tavily (선택 — 없으면 DuckDuckGo 무료로 자동 폴백)
# 발급: https://app.tavily.com
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 파인튜닝 모델 (선택) ─────────────────────────────────────
# OpenAI 파인튜닝 완료 모델 ID (있을 경우 GPT 대신 사용)
# FINETUNED_MODEL=ft:gpt-4o-mini:your-org:model-name:xxxxxxxx

# ── 병렬 실행 설정 ───────────────────────────────────────────
# 유료 API(Claude/GPT/Gemini) 동시 호출 수 (기본값: 3)
# GitHub 무료 티어는 항상 1로 고정됨
# LLM_CONCURRENCY=3

# ── 워크스페이스 경로 ────────────────────────────────────────
# 프로젝트 파일 저장 경로 (기본값: ./workspaces)
# WORKSPACE_ROOT=./workspaces
